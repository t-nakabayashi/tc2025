<launch>

    <!-- 条件付きTFパブリッシャー: odom→base_link -->
    <!-- fastlio_mappingが/Odometryを発行する前から原点でodomフレームを確立し、
         /Odometry受信後は実際の位置をパブリッシュ -->
    <node pkg="tc2025" type="conditional_tf_publisher.py" name="conditional_tf_publisher" output="screen">
        <param name="odom_topic" value="/Odometry" />
    </node>

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

    <!-- 信号検出ノード（respawn=falseで独立して起動、FAST-LIOに影響しない） -->
    <node pkg="tc2025" type="tc2023_signal_detector.py" name="signal_detector" output="screen" respawn="false" launch-prefix="bash -c 'sleep 3; exec $0 $@' " />

</launch>

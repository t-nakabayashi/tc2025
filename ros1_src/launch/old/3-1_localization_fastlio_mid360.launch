<launch>
    <!-- FAST_LIO_LOCALIZATION with MID360 for TC2025 -->
    <!-- Usage: Play rosbag with data from 1_init_robot_tc2024_joystick.launch -->

    <!-- ========== Arguments ========== -->
    <arg name="rviz" default="true" />
    <arg name="map" default="$(find fast_lio)/PCD/scans_light_origin.pcd" />
    <arg name="bag_file" default="" />

    <!-- Initial pose (origin-aligned map, start at 0,0,0) -->
    <arg name="initial_pose_x" default="0.0" />
    <arg name="initial_pose_y" default="0.0" />
    <arg name="initial_pose_z" default="0.0" />
    <arg name="initial_pose_yaw" default="0.0" />

    <!-- Use simulation time for rosbag playback -->
    <param name="/use_sim_time" value="true" />

    <!-- ========== TF Publishers ========== -->
    <node pkg="tf" type="static_transform_publisher" name="tf_base2mid360" args="0 0 1.005 0 0 0 /base_link /mid360_frame 10" />
    <node pkg="tf" type="static_transform_publisher" name="tf_base2laser" args="0.075 0 0.49 0 0 0 /base_link /laser 10" />
    <node pkg="tf" type="static_transform_publisher" name="tf_base2gps" args="0.075 0 0.49 0 0 0 /base_link /gps 10" />

    <!-- ========== Rosbag Playback ========== -->
    <node pkg="rosbag" type="play" name="rosbag_play" args="--clock $(arg bag_file)" if="$(eval bag_file != '')" />

    <!-- ========== FAST_LIO_LOCALIZATION ========== -->
    <rosparam command="load" file="$(find fast_lio_localization)/config/mid360.yaml" />

    <param name="feature_extract_enable" type="bool" value="false"/>
    <param name="point_filter_num" type="int" value="3"/>
    <param name="max_iteration" type="int" value="3" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="false" />
    <param name="pcd_save_enable" type="bool" value="false" />

    <node pkg="fast_lio_localization" type="fastlio_localization_mapping" name="laserMapping" output="screen" />

    <!-- Global Localization (initial pose estimation) -->
    <node pkg="fast_lio_localization" type="global_localization.py" name="global_localization" output="screen" />

    <!-- Publish initial pose automatically (x y z yaw pitch roll) -->
    <node pkg="fast_lio_localization" type="publish_initial_pose.py" name="initial_pose_publisher" output="screen"
          args="$(arg initial_pose_x) $(arg initial_pose_y) $(arg initial_pose_z) $(arg initial_pose_yaw) 0 0"
          launch-prefix="bash -c 'sleep 5; exec $0 $@' " />

    <!-- Transform Fusion (publishes map->odom->base_link TF) -->
    <node pkg="fast_lio_localization" type="transform_fusion.py" name="transform_fusion" output="screen" />

    <!-- Publish PCD map as PointCloud2 -->
    <node pkg="pcl_ros" type="pcd_to_pointcloud" name="map_publisher" output="screen"
          args="$(arg map) 5 _frame_id:=map cloud_pcd:=/map" />

    <!-- ========== RViz ========== -->
    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
              args="-d $(find fast_lio_localization)/rviz_cfg/localization.rviz" />
    </group>

</launch>
